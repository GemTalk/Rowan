#!/usr/bin/env superdoit_rowan3_solo
options
{
SuperDoitOptionalOptionWithNoArg long: 'includeClassInitializers'.
SuperDoitOptionalOptionWithNoArg long: 'includeRemoveAllMethods'.
SuperDoitOptionalOptionWithRequiredArg long: 'headerFile'.
SuperDoitOptionalOptionWithRequiredArg long: 'projectsHome' default: '$ROWAN_PROJECTS_HOME'.
SuperDoitOptionalOptionWithRequiredArg long: 'projectAlias'.
}
%
usage
-----
USAGE
      $basename <spec-url> <topaz-file-name> [--projectAlias=<project-alias> ] \
      [--includeClassInitializers] [--includeRemoveAllMethods] \
      [--headerFile=<header-filename>] [--projectsHome=<projects-home-directory>]

DESCRIPTION
  Read the project denoted by <spec-url> from disk and export it to a .gs file name
  <topaz-file-path>.

OPTIONS
  <spec-url>           Url referencing the load spec of the project, the load.
                       Spec is used to read the project from disk.
  <topaz-file-name>    Full name of the topaz .gs file
  --projectsHome=<projects-home-directory>
                       The directory where the project is located. By default,
                       $ROWAN_PROJECTS_HOME.
  --projectAlias=<project-alias>
                       The name of the project directory on disk, if different
                       than the project name in the load spec.
  --headerFile=<header-filename>
                       Specify the name of the file that contains the desired header.
                       This option is only supported in Rowan version 3.5.0 and greater.
  --includeClassInitializers
                       Include class initialization expressions at the end of 
                       the file out for each class with a change to it's class
                       initialization method.
  --includeRemoveAllMethods
                       Include removeallmethods and removeallclassmethods topaz commands
                       for each added class.                       
  -h, --help           Display usage message
  -D, --debug          Bring up topaz debugger in the event of a script error.

EXAMPLES
  $basename -h
  $basename file:$ROWAN_PROJECTS_HOME/MyProject/rowan/specs/MyProject.ston \
            $ROWAN_PROJECTS_HOME/MyProject/gemstone/MyProject.gs
  $basename file:/home/daleh/projects/MyProject/rowan/specs/MyProject.ston  \
            $ROWAN_PROJECTS_HOME/MyProject/gemstone/MyProject.gs \
            --projectsHome=/home/daleh/projects/
  $basename file:/home/daleh/projects/MyProject/rowan/specs/MyProject.ston  \
            $ROWAN_PROJECTS_HOME/MyProject/gemstone/MyProject.gs \
            --projectsHome=/home/daleh/projects/ \
            --projectAlias=MyProjectV3 --includeClassInitializers --includeRemoveAllMethods \
            --headerFile=header.txt

-----
%
doit
	| loadSpecUrl args loadSpec resolvedProject topazFilename projectAlias projectName theHeader projectSet |
	args := self positionalArgs.
	args size ~= 2
		ifTrue: [
			self usage. 
			self error: 'expected two positional arguments: <spec-url> <topaz-file-name>' ].
	loadSpecUrl := args removeFirst.
	topazFilename := args removeFirst.
	loadSpec := RwSpecification fromUrl: loadSpecUrl.
	projectName := loadSpec projectName.
	projectAlias := self projectAlias ifNil: [ projectName ]. 
	loadSpec
		diskUrl: 'file://', self projectsHome asFileReference fullName, '/', projectAlias;
		projectsHome: self projectsHome;
		yourself.
	projectSet := (loadSpec resolve: loadSpec customConditionalAttributes, Rowan platformConditionalAttributes) read.
	theHeader := self headerFile
		ifNil: [
			(projectSet projectNamed: projectName)
				exportTopazFormatTo: topazFilename 
				logClassCreation: false 
				excludeClassInitializers: self includeClassInitializers not
				excludeRemoveAllMethods: self includeRemoveAllMethods not ]
		ifNotNil: [:theFileName |
			(Rowan version < '3.5.0' asRwSemanticVersionNumber)
				ifTrue: [ self error: '--headerFile option not supported in Rowan version ', Rowan version printString].
					(projectSet projectNamed: projectName)
						exportTopazFormatTo: topazFilename 
						logClassCreation: false 
						excludeClassInitializers: self includeClassInitializers not
						excludeRemoveAllMethods: self includeRemoveAllMethods not
						topazFileHeader: theFileName asFileReference contents ].
	^ self noResult.
%
